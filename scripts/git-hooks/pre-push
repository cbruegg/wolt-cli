#!/usr/bin/env bash
# pre-push — full local pre-push gate, mirrors the remote Go CI exactly.
# Source of truth for the policy: AGENTS.MD "Pre-Push Validation Rule".
#
# Runs:
#   1. go mod download
#   2. go build ./...
#   3. versioned CLI binary build + --version round-trip check
#   4. golangci-lint run (warns if missing, doesn't block — install hint
#      printed; remote CI will still catch it)
#   5. go test ./...
#   6. go test -race ./...
#
# Skipped:
#   - When you're not pushing to "main" or a tag (feature branches
#     finish CI on the PR; running the gate twice is wasteful).
#   - For deletions (no new sha to validate).
#
# Bypass for emergencies: git push --no-verify
#
# Installed by scripts/install-git-hooks.sh.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "${repo_root}" ] || exit 0
cd "${repo_root}"

# Inspect refs being pushed. stdin lines:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Skip the gate when the only thing being pushed is a deletion or when
# we're not targeting main / a release tag.
should_run=0
zero="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ -z "${local_sha}" ] && continue
  [ "${local_sha}" = "${zero}" ] && continue
  case "${remote_ref}" in
    refs/heads/main|refs/tags/v*) should_run=1 ;;
  esac
done

if [ "${should_run}" -eq 0 ]; then
  exit 0
fi

step() {
  printf "\n-> %s\n" "$1"
}

fail() {
  echo "" >&2
  echo "pre-push: $1" >&2
  echo "fix the issue and re-push, or bypass with: git push --no-verify" >&2
  exit 1
}

step "go mod download"
go mod download || fail "go mod download failed"

step "go build ./..."
go build ./... || fail "go build ./... failed"

step "versioned binary + version check"
BUILD_VERSION="$(git describe --tags --always --dirty)"
mkdir -p bin
go build -trimpath -ldflags "-s -w -X main.version=${BUILD_VERSION}" -o bin/wolt ./cmd/wolt \
  || fail "versioned binary build failed"
actual_version="$(./bin/wolt --version | tr -d '\r\n')"
if [ "${actual_version}" != "${BUILD_VERSION}" ]; then
  fail "wolt --version mismatch: expected '${BUILD_VERSION}', got '${actual_version}'"
fi

step "golangci-lint run"
if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run || fail "golangci-lint reported issues"
else
  echo "  (skipped -- install with: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.4.0)"
fi

step "go test ./..."
go test ./... || fail "go test ./... failed"

step "go test -race ./..."
go test -race ./... || fail "go test -race ./... failed"

echo ""
echo "pre-push gate passed for ${BUILD_VERSION}"
